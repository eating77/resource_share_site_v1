# 说明：@cloudflare/next-on-pages@1.13.16 的 peerDependencies 声明的版本区间
#       （next <=15.5.2、vercel <=47.0.4、wrangler ^3||^4、workers-types ^4）
#       与 npm 的严格 peer 校验天然容易冲突。
# 把这个文件提交到仓库，Cloudflare Pages 在跑自动安装（npm ci）时也会读取项目根目录的
# .npmrc，因此比在面板上配置 NPM_CONFIG_LEGACY_PEER_DEPS 环境变量更可靠
# （环境变量只对 CF 自己的安装步骤生效，管不到 npx 另外拉包的场景）。
legacy-peer-deps=true
fund=false
audit=false
