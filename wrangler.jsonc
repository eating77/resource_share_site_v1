{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resource-share-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat：提供 Buffer / node:crypto / process.env 等 Node.js API（必需）
  // global_fetch_strictly_public：允许应用内向 Supabase 发起 fetch（必需）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "resource-share-site"
    }
  ],
  "observability": {
    "enabled": true
  }
  // 本项目全站 force-dynamic，无 ISR，故不配置 r2_buckets。
  // 未来若引入 ISR，需新增 NEXT_INC_CACHE_R2_BUCKET 绑定并在 open-next.config.ts 启用 r2IncrementalCache。
}
